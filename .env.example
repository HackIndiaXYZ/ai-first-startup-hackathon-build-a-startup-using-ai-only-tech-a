# Duplicate as .env locally and fill only the integrations you configure.
GEMINI_API_KEY=your-gemini-api-key

# Email verification and password reset.
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-smtp-user
SPRING_MAIL_PASSWORD=your-smtp-app-password
MAIL_FROM=dukaan-dost@example.com
APP_BASE_URL=http://localhost:8080

# Optional Google OpenID Connect. Register this redirect URL with Google:
# http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Optional SMS provider (phone OTP remains disabled unless a supported provider is configured).
SMS_PROVIDER_URL=
SMS_API_KEY=
SMS_SENDER=

# Optional local profile image storage override. Keep this outside any static web root.
AVATAR_STORAGE_DIR=./data/avatars

# Optional shop details used in local reminder drafts.
SHOP_NAME=
UPI_ID=
